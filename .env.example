# App
APP_ENV=development
SECRET_KEY=change-me-to-random-32-chars
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/finance_agent

# Main Project API
MAIN_API_URL=http://127.0.0.1:5000
MAIN_API_TIMEOUT=10

# LLM
LLM_PROVIDER=gigachat
LLM_API_KEY=
LLM_MODEL=

# GigaChat
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-3-Pro
GIGACHAT_VERIFY_SSL=true

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=webhook
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_RATE_LIMIT=10
TELEGRAM_RATE_WINDOW=60