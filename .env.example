# App
APP_ENV=development
SECRET_KEY=change-me-to-random-32-chars
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://agent:password@postgres:5432/finance_agent

# Main Project API
# На VPS резолвится через extra_hosts в docker-compose.prod.yml:
MAIN_API_URL=https://projectfin.com.ru
MAIN_API_TIMEOUT=10

# Redis — опционально (для rate limit): без него middleware
# работает в in-memory режиме (лимит на процесс, не на пользователя).
REDIS_URL=redis://redis:6379/0

# LLM
# mock — для локальной разработки без сети (возвращает заглушки)
# gigachat — основной провайдер, требует GIGACHAT_CREDENTIALS ниже
# openrouter — fallback, требует LLM_API_KEY и LLM_MODEL
LLM_PROVIDER=gigachat
LLM_API_KEY=
LLM_MODEL=

# GigaChat
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-3-Pro
GIGACHAT_VERIFY_SSL=true

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=webhook
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_RATE_LIMIT=10
TELEGRAM_RATE_WINDOW=60